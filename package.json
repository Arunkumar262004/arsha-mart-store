{
  "name": "order-inventory-system",
  "private": true,
  "description": "Runs the Laravel API, the queue worker and the React app with one command.",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names api,queue,web --prefix-colors blue,magenta,green \"npm:dev:api\" \"npm:dev:queue\" \"npm:dev:web\"",
    "dev:api": "cd backend && php artisan serve --port=8000",
    "dev:queue": "cd backend && php artisan queue:listen --tries=3 --timeout=60",
    "dev:web": "npm --prefix frontend run dev",
    "test": "cd backend && php artisan test"
  },
  "devDependencies": {
    "concurrently": "^9.2.0"
  }
}
